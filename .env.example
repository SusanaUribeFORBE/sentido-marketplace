# ============================================================
# SENTIDO Marketplace — Plantilla de variables de entorno
# Copia este archivo como ".env" y completa los valores reales
# ============================================================

# ── SUPABASE ─────────────────────────────────────────────────
# La anon key de Supabase es PÚBLICA por diseño — va en supabase-config.js
# No necesita ir en .env. La seguridad viene del RLS en la base de datos.
# SUPABASE_URL y SUPABASE_ANON_KEY están en supabase-config.js

# ── GROQ (Agente IA) ─────────────────────────────────────────
# Consigue tu key en: console.groq.com → API Keys (gratis)
GROQ_API_KEY=gsk_TU_GROQ_KEY
GROQ_MODEL=llama-3.1-8b-instant

# ── EMAILJS (Envío de correos HTML) ──────────────────────────
# Configura en: emailjs.com → Dashboard (gratis hasta 200 emails/mes)
EMAILJS_PUBLIC_KEY=TU_PUBLIC_KEY
EMAILJS_SERVICE_ID=TU_SERVICE_ID
EMAILJS_TEMPLATE_ID=TU_TEMPLATE_ID

# ── ADMIN ────────────────────────────────────────────────────
ADMIN_PASSWORD=sentido2026
ADMIN_EMAIL=sentidomercado@hotmail.com
ADMIN_WA=573XXXXXXXXX   # número WhatsApp con código de país, sin +
